# --- PseudoGram -------------------------------------------------------------
# The API key is also the HMAC secret used to verify inbound webhook signatures.
PSEUDOGRAM_API_KEY=
PSEUDOGRAM_EMAIL=you@example.com
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# --- Storage ----------------------------------------------------------------
# Local default is SQLite. In production point this at Postgres (Neon/Render):
#   DATABASE_URL=postgresql://user:pass@host/db
# postgres:// and postgresql:// are both accepted and rewritten to asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./linkplease.db

# --- Behaviour --------------------------------------------------------------
REQUIRE_SIGNATURE=1
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=61
MAX_SEND_ATTEMPTS=6
MAX_RESENDS=2
RUN_WORKERS=1

# "all" counts redelivered events + repeat comments; "repeat" counts repeats only.
DUPLICATE_DEFINITION=all

# Set to enable POST /admin/reset between self-grading runs.
ADMIN_TOKEN=
